{
  "name": "eslint-plugin-ignifx",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-internal ESLint rules for ignifx (coding standards §6): adapter boundary, import-time side effects, lifecycle, signals, schemas, error codes, console.",
  "license": "Apache-2.0",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build tsconfig.json tsconfig.test.json",
    "test": "vitest run --project node --root ../.. tools/eslint-plugin-ignifx"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/rule-tester": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "typescript-native": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  }
}
