# Prettier formats Markdown only (coding standards §6); oxfmt owns every other language.
node_modules/
dist/
coverage/
.turbo/
.tsbuild/
.tsbuild-test/
# Agent worktrees are whole checkouts of their own (`.git/info/exclude`); they lint themselves.
.claude/
# Generated Markdown is never hand-formatted (standards §15).
packages/*/api/*.api.md
# Skill pages, generated and hand-written. Agents load them on every task, and Prettier pads each
# table column to its widest cell (40% of the entry skill's bytes), so their tables are written with
# single-space cells and left alone. `packages/*/skills/` also covers the pack-time copy of the entry
# skill inside the umbrella package (packages/ignifx/.gitignore).
skills/ignifx/
packages/*/skills/
**/CHANGELOG.md
.changeset/*.md
# Electron desktop build output (see .oxfmtignore).
templates/*/out/
templates/*/release/
# Third-party decoders and their licence texts, written by `pnpm vendor:decoders`.
packages/core/decoders/
