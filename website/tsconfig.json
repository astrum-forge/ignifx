{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The website is a bundled application, not a published package: Vite resolves and emits, `tsc`
    // only type-checks (coding standards §3 — apps and the website use `preserve`/`bundler`).
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    // `src/theme.ts` has no imports and exports nothing, which would otherwise make it a global
    // script file; Vite loads it as an ES module, so type-check it as one.
    "moduleDetection": "force",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    // No WebGPU here — the shell renders DOM only, and `DOM`/`DOM.Iterable` come from the base
    // config. `vite/client` supplies `import.meta.env` and Vite's asset module declarations.
    "types": ["vite/client", "node", "@webgpu/types"]
  },
  "include": [
    "src",
    "scripts",
    "test",
    "examples",
    "press",
    "brand",
    "site.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
