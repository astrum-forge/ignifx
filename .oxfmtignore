# Markdown is formatted by Prettier, not oxfmt (coding standards §6). Prettier is not wired up in
# Phase 0, so Markdown is simply not machine-formatted yet.
**/*.md

# Generated or vendored files are never hand-formatted.
pnpm-lock.yaml
**/api/*.api.md
skills/ignifx/references/api/**

# Written by `tests/fixtures/assets/2d-templates/make-template-*.mjs`. Re-running a generator must
# not leave a formatting diff behind, and the run-length-encoded tile arrays are deliberately on one
# line each — a formatter would put every integer on its own.
templates/*/assets/*.atlas.json
templates/*/assets/level.tilemap.json

# Electron desktop build output. `templates/*/out/**` is bundled JavaScript from `electron-vite`
# and `templates/*/release/**` is a packaged application; neither is hand-written.
templates/*/out/**
templates/*/release/**

# Written by `website/examples/tilemap/tools/build-2d-assets.ts` from the two Tiled maps beside the
# examples that load them. Same reasoning as the template assets above: re-running the generator
# must not leave a formatting diff, the run-length-encoded tile arrays are deliberately one line
# each, and the `.tmj.json` sources keep one map row per line so a reader can see the grid.
website/examples/assets/2d/*.json
website/examples/*/*.tmj.json
