# Prettier formats Markdown (coding standards §6).
**/*.md

# Generated or vendored files are never hand-formatted.
pnpm-lock.yaml
# Written by `pnpm docs:schemas` as `JSON.stringify(…, null, 2)`; the regeneration check compares
# it byte for byte, and a formatter would put a field's short `values` list on one line.
skills/ignifx/references/formats/ignifx.schemas.json

# Agent worktrees are whole checkouts of their own (`.git/info/exclude`); they lint themselves.
.claude/**
**/api/*.api.md
skills/ignifx/references/api/**

# Written by `tests/fixtures/assets/2d-templates/make-template-*.mjs`. Re-running a generator must
# not leave a formatting diff behind, and the run-length-encoded tile arrays are deliberately on one
# line each — a formatter would put every integer on its own.
templates/*/assets/*.atlas.json
templates/*/assets/level.tilemap.json

# Written by core's `stringifySceneFile`, whose canonical text is the scene format's own (one value
# per line, no final newline). The template tests compare a load-and-save of each file against it
# byte for byte, so a formatter's layout would fail them.
templates/*/assets/scenes/*.scene.json

# Electron desktop build output. `templates/*/out/**` is bundled JavaScript from `electron-vite`
# and `templates/*/release/**` is a packaged application; neither is hand-written.
templates/*/out/**
templates/*/release/**

# Third-party decoders Babylon Lite loads at run time, written by `pnpm vendor:decoders` with the
# SHA-256 of each file recorded in `vendored.json`; a formatter run would break the digests.
packages/core/decoders/**
