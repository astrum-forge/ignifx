{
  "name": "ignifx-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for ignifx — a WebGPU-only TypeScript game engine by Astrum Forge Studios.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "tsc --project tsconfig.tools.json && turbo run typecheck",
    "lint": "oxlint --type-aware && eslint .",
    "format": "oxfmt --ignore-path .gitignore --ignore-path .oxfmtignore . && prettier --write --log-level warn \"**/*.md\"",
    "format:check": "oxfmt --check --ignore-path .gitignore --ignore-path .oxfmtignore . && prettier --check --log-level warn \"**/*.md\"",
    "test": "vitest run --project node --coverage",
    "test:browser": "vitest run --project browser",
    "test:visual": "pnpm --filter ignifx-visual-tests run test:visual",
    "test:frame-budget": "pnpm --filter ignifx-visual-tests run test:frame-budget",
    "bench": "vitest bench --run --reporter=verbose benchmarks",
    "bundle-size": "vitest run --project node benchmarks/bundle-size.test.ts",
    "assets:2d": "node tests/fixtures/assets/2d-templates/make-template-art.mjs",
    "assets:levels": "node tests/fixtures/assets/2d-templates/make-template-levels.mjs",
    "assets:3d": "node tests/fixtures/assets/3d-templates/make-level-art.mjs",
    "assets:audio": "node tests/fixtures/assets/audio-templates/make-template-audio.mjs",
    "assets": "pnpm run assets:2d && pnpm run assets:levels && pnpm run assets:3d && pnpm run assets:audio",
    "capture:gallery": "pnpm --filter ignifx-visual-tests run capture:gallery",
    "api-report": "turbo run api-report",
    "pack-check": "turbo run pack-check",
    "docs:api": "turbo run docs:api",
    "docs:schemas": "node scripts/docs-schemas.ts",
    "docs:recipes": "node scripts/docs-recipes.ts",
    "docs:llms": "node scripts/docs-llms.ts",
    "docs:harness": "node scripts/docs-harness.ts",
    "licenses:notices": "node scripts/licenses.ts",
    "licenses:check": "node scripts/licenses.ts --check",
    "deps": "depcruise --config .dependency-cruiser.cjs packages",
    "changeset": "changeset",
    "release": "pnpm build && pnpm exec changeset publish",
    "release:verify": "node scripts/verify-published.ts",
    "check": "pnpm run build && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run api-report && pnpm run docs:harness"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@eslint/js": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@types/webxr": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@webgpu/types": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-ignifx": "workspace:*",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "lefthook": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "typescript-native": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.20"
  },
  "packageManager": "pnpm@11.17.0"
}
