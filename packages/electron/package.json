{
  "name": "@ignifx/electron",
  "version": "0.0.0",
  "description": "ignifx Electron support: main-process window factory with WebGPU flags, typed preload bridge, file-system storage.",
  "keywords": [
    "ignifx",
    "ignifx-extension"
  ],
  "homepage": "https://ignifx.com",
  "license": "Apache-2.0",
  "author": "Astrum Forge Studios",
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build tsconfig.json tsconfig.test.json",
    "test": "vitest run --project node --root ../.. packages/electron",
    "api-report": "api-extractor run --verbose",
    "docs:api": "typedoc",
    "api-report:update": "api-extractor run --local --verbose",
    "pack-check": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@ignifx/core": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@types/webxr": "catalog:",
    "@webgpu/types": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript-native": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ignifx/core": "workspace:*"
  },
  "ignifx": {
    "extension": true,
    "engine": ">=0.0.0 <1.0.0",
    "requires": [],
    "optional": [],
    "capabilities": [],
    "skill": "./skills/electron/SKILL.md"
  }
}
