{
  "name": "@ignifx/core",
  "version": "0.0.0",
  "description": "ignifx core: app, world, entities, components, scripts, and the Babylon Lite adapter boundary.",
  "homepage": "https://ignifx.com",
  "license": "Apache-2.0",
  "author": "Astrum Forge Studios",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build tsconfig.json tsconfig.test.json",
    "test": "vitest run --project node --root ../.. packages/core",
    "api-report": "api-extractor run --verbose",
    "docs:api": "typedoc",
    "api-report:update": "api-extractor run --local --verbose",
    "pack-check": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@babylonjs/lite": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@babylonjs/havok": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/webxr": "catalog:",
    "@webgpu/types": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript-native": "catalog:",
    "vitest": "catalog:"
  }
}
