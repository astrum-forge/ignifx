{
  "name": "@ignifx/devtools",
  "version": "0.2.2",
  "description": "ignifx devtools: stats overlay, scene tree and component inspector, physics debug view, script hot reload.",
  "keywords": [
    "ignifx",
    "ignifx-extension"
  ],
  "homepage": "https://ignifx.com",
  "license": "Apache-2.0",
  "author": "Astrum Forge Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrum-forge/ignifx.git",
    "directory": "packages/devtools"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build tsconfig.json tsconfig.test.json",
    "test": "vitest run --project node --root ../.. packages/devtools",
    "api-report": "api-extractor run --verbose",
    "docs:api": "typedoc",
    "api-report:update": "api-extractor run --local --verbose",
    "pack-check": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@babylonjs/havok": "catalog:",
    "@ignifx/audio": "workspace:*",
    "@ignifx/core": "workspace:*",
    "@ignifx/input": "workspace:*",
    "@ignifx/physics": "workspace:*",
    "@ignifx/physics-2d": "workspace:*",
    "@ignifx/ui": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@types/webxr": "catalog:",
    "@webgpu/types": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript-native": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@ignifx/audio": "workspace:*",
    "@ignifx/core": "workspace:*",
    "@ignifx/input": "workspace:*",
    "@ignifx/physics": "workspace:*",
    "@ignifx/physics-2d": "workspace:*",
    "@ignifx/ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ignifx/audio": {
      "optional": true
    },
    "@ignifx/input": {
      "optional": true
    },
    "@ignifx/physics": {
      "optional": true
    },
    "@ignifx/physics-2d": {
      "optional": true
    },
    "@ignifx/ui": {
      "optional": true
    }
  },
  "ignifx": {
    "extension": true,
    "engine": ">=0.0.0 <1.0.0",
    "requires": [],
    "optional": [
      "@ignifx/audio",
      "@ignifx/input",
      "@ignifx/physics",
      "@ignifx/physics-2d",
      "@ignifx/ui"
    ],
    "capabilities": [],
    "skill": "./skills/devtools/SKILL.md"
  }
}
