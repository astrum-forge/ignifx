            "fields": {
              "position": {
                "kind": "vec3",
                "default": [0, 0, 0],
                "description": "Local position relative to the parent, in metres.",
                "step": 0.01
              },
              "rotation": {
                "kind": "quat",
                "default": [0, 0, 0, 1],
                "description": "Local rotation relative to the parent: a unit quaternion [x, y, z, w], shown as intrinsic XYZ Euler angles in degrees.",
                "step": 0.5
              },
              "scale": {
                "kind": "vec3",
                "default": [1, 1, 1],
                "description": "Local scale relative to the parent.",
                "step": 0.01
              }
            },
            "builtIn": true,
            "propsSchema": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "x-ignifx-step": 0.01,
                  "description": "Local position relative to the parent, in metres.",
                  "default": [0, 0, 0]
                },
                "rotation": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4,
                  "x-ignifx-step": 0.5,
                  "description": "Local rotation relative to the parent: a unit quaternion [x, y, z, w], shown as intrinsic XYZ Euler angles in degrees.",
                  "default": [0, 0, 0, 1]
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3,
                  "x-ignifx-step": 0.01,
                  "description": "Local scale relative to the parent.",
                  "default": [1, 1, 1]
                }
              },
              "additionalProperties": false
            }
          },
          "ignifx/Camera": {
            "title": "Camera",
            "format": "components",
            "description": "The camera an entity renders the world through; the entity's transform is the view.",
            "fields": {
              "fov": {
                "kind": "f32",
                "default": 60,
                "description": "Vertical field of view, in degrees."
              },
              "near": {
                "kind": "f32",
                "default": 0.1
              },
              "far": {
                "kind": "f32",
                "default": 1000
              },
              "projection": {
                "kind": "enum",
                "default": "perspective"
              }
            },
            "propsSchema": {
              "type": "object",
              "properties": {
                "fov": {
                  "type": "number",
                  "description": "Vertical field of view, in degrees.",
                  "minimum": 1,
                  "maximum": 179,
                  "default": 60
                },
                "near": {
                  "type": "number",
                  "default": 0.1
                },
                "far": {
                  "type": "number",
                  "default": 1000
                },
                "projection": {
                  "type": "string",
                  "enum": ["perspective", "orthographic"],
                  "default": "perspective"
                }
              },
              "additionalProperties": false
            }
          },
          "game/Health": {
            "title": "Health",
            "format": "components",
            "fields": {
              "max": {
                "kind": "u32",
                "default": 100
              },
              "regenPerSecond": {
                "kind": "f32",
                "default": 0
              }
            },
            "propsSchema": {
              "type": "object",
              "properties": {
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295,
                  "default": 100
                },
                "regenPerSecond": {
                  "type": "number",
                  "default": 0
                }
              },
              "additionalProperties": false
            }
          },
          "ignifx/scene-file": {
            "title": "Scene file",
            "format": "ignifx.scene",
            "description": "A level or a prefab: a tree of entities with components, instanced scenes, and overrides. One format for both (ADR-0005).",
            "fields": {
              "format": {
                "kind": "str",
                "default": "ignifx.scene",
                "description": "Always \"ignifx.scene\"."
              },
              "name": {
                "kind": "str",
                "default": "",
                "description": "The scene's name."
              }
            }
          }
        }
      }
