{
  "name": "@ignifx/ui",
  "version": "0.2.1",
  "description": "ignifx UI: DOM overlay host, focus routing, world and HUD text.",
  "keywords": [
    "ignifx",
    "ignifx-extension"
  ],
  "homepage": "https://ignifx.com",
  "license": "Apache-2.0",
  "author": "Astrum Forge Studios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astrum-forge/ignifx.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --build tsconfig.json tsconfig.test.json",
    "test": "vitest run --project node --root ../.. packages/ui",
    "api-report": "api-extractor run --verbose",
    "docs:api": "typedoc",
    "api-report:update": "api-extractor run --local --verbose",
    "pack-check": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@babylonjs/lite": "catalog:",
    "@ignifx/core": "workspace:*",
    "@ignifx/input": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@types/webxr": "catalog:",
    "@webgpu/types": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typescript-native": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@babylonjs/lite": "catalog:",
    "@ignifx/core": "workspace:*",
    "@ignifx/input": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ignifx/input": {
      "optional": true
    }
  },
  "ignifx": {
    "extension": true,
    "engine": ">=0.0.0 <1.0.0",
    "requires": [],
    "optional": [
      "@ignifx/input"
    ],
    "capabilities": [
      "components",
      "systems",
      "services",
      "settings",
      "assets"
    ],
    "skill": "./skills/ui/SKILL.md"
  }
}
